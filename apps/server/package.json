{
  "name": "@gcchat/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "tsx src/scripts/runPrisma.ts generate",
    "prisma:migrate": "tsx src/scripts/runPrisma.ts migrate dev",
    "prisma:deploy": "tsx src/scripts/runPrisma.ts migrate deploy",
    "prisma:studio": "tsx src/scripts/runPrisma.ts studio"
  },
  "dependencies": {
    "@gcchat/shared": "workspace:*",
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.49.1",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.4.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "vitest": "^3.0.7"
  }
}
